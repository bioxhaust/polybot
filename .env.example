# Paper trading only. No wallet keys are needed at any stage of PLAN.md.
POLYBOT_DB_PATH=data/polybot.sqlite
POLYBOT_ASSETS=BTC,ETH
POLYBOT_POLL_SECONDS=30
# Book snapshots, fair probabilities and outcome checks are persisted this often.
POLYBOT_SNAPSHOT_SECONDS=300

# Risk (see PLAN.md, task E)
POLYBOT_BANKROLL_USD=10000
POLYBOT_RISK_UNIT_PCT=0.005
# Paper run: 1000R is $50k, so a losing day does not pause the bot.
POLYBOT_DAILY_LOSS_LIMIT_R=1000
POLYBOT_WEEKLY_LOSS_LIMIT_R=7
POLYBOT_THEME_LIMIT_R=3
POLYBOT_MAX_SHARE_OF_VOLUME=0.01

# Signals (see PLAN.md, tasks C and E)
POLYBOT_MIN_EDGE=0.03
POLYBOT_TAKER_FEE_RATE=0.0
# Near expiry a 30s poll loses to bots watching Binance live: no directional entries then.
POLYBOT_MIN_TRADE_TTE_MINUTES=60
